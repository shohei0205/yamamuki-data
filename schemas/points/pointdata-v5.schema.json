{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "地点データ（版5）",
  "description": "gzip 展開後の JSON 配列。id のデータセット内での一意性と、別名が表示名と異なることは別途検証する。",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/$defs/point"
  },
  "$defs": {
    "point": {
      "type": "object",
      "required": [
        "id",
        "name",
        "latitude",
        "longitude"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "\\S"
        },
        "osmId": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "elevationM": {
          "type": [
            "number",
            "null"
          ]
        },
        "nameReading": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "uniqueItems": true
        },
        "wikipediaUrl": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https://[^/?#\\s]+"
            },
            {
              "type": "null"
            }
          ]
        },
        "wikidataUrl": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https://[^/?#\\s]+"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
