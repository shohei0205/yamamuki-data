{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "地点補足対応表",
  "type": "object",
  "required": [
    "points"
  ],
  "additionalProperties": false,
  "properties": {
    "tag": {
      "type": "string",
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "source": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "attribution": {
      "type": "string"
    },
    "changes": {
      "type": "string"
    },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "osmId"
        ],
        "properties": {
          "osmId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "nameReading": {
            "type": "string",
            "pattern": "^\\S(?:.*\\S)?$"
          },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^\\S(?:.*\\S)?$"
            }
          },
          "note": {
            "type": "string",
            "description": "対応表を編集する人向けの任意のメモ。地点名の変更や一致判定には使わず、配布する地点データには追加しない。"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "not": {
          "required": [
            "tag"
          ]
        }
      },
      "then": {
        "properties": {
          "points": {
            "items": {
              "anyOf": [
                {
                  "required": [
                    "nameReading"
                  ]
                },
                {
                  "required": [
                    "aliases"
                  ]
                }
              ]
            }
          }
        }
      }
    }
  ]
}
