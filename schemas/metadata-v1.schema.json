{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "共通メタデータ（版1）",
  "description": "データ JSON と配布 manifest で共有する metadata。各項目は任意。データ種別ごとの必須条件は参照元で追加する。",
  "type": "object",
  "properties": {
    "sources": {
      "$ref": "#/$defs/sources"
    },
    "tags": {
      "$ref": "#/$defs/tags"
    },
    "pointCount": {
      "type": "integer",
      "minimum": 1
    },
    "authors": {
      "$ref": "#/$defs/authors"
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "language": {
      "type": "string",
      "pattern": "^(?:(?:[A-Za-z]{2,3}(?:-[A-Za-z]{3}){0,3}|[A-Za-z]{4}|[A-Za-z]{5,8})(?:-[A-Za-z]{4})?(?:-[A-Za-z]{2}|-[0-9]{3})?(?:-[A-Za-z0-9]{5,8}|-[0-9][A-Za-z0-9]{3})*(?:-[0-9A-WY-Za-wy-z](?:-[A-Za-z0-9]{2,8})+)*(?:-[xX](?:-[A-Za-z0-9]{1,8})+)?|[xX](?:-[A-Za-z0-9]{1,8})+|[aA][rR][tT]-[lL][oO][jJ][bB][aA][nN]|[cC][eE][lL]-[gG][aA][uU][lL][iI][sS][hH]|[eE][nN]-[gG][bB]-[oO][eE][dD]|[iI]-[aA][mM][iI]|[iI]-[bB][nN][nN]|[iI]-[dD][eE][fF][aA][uU][lL][tT]|[iI]-[eE][nN][oO][cC][hH][iI][aA][nN]|[iI]-[hH][aA][kK]|[iI]-[kK][lL][iI][nN][gG][oO][nN]|[iI]-[lL][uU][xX]|[iI]-[mM][iI][nN][gG][oO]|[iI]-[nN][aA][vV][aA][jJ][oO]|[iI]-[pP][wW][nN]|[iI]-[tT][aA][oO]|[iI]-[tT][aA][yY]|[iI]-[tT][sS][uU]|[nN][oO]-[bB][oO][kK]|[nN][oO]-[nN][yY][nN]|[sS][gG][nN]-[bB][eE]-[fF][rR]|[sS][gG][nN]-[bB][eE]-[nN][lL]|[sS][gG][nN]-[cC][hH]-[dD][eE]|[zZ][hH]-[gG][uU][oO][yY][uU]|[zZ][hH]-[hH][aA][kK][kK][aA]|[zZ][hH]-[mM][iI][nN]|[zZ][hH]-[mM][iI][nN]-[nN][aA][nN]|[zZ][hH]-[xX][iI][aA][nN][gG])$(?![\\s\\S])",
      "description": "文字列の主な言語（BCP 47）。variant・拡張の重複は公開処理で検証する。"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^\\S(?:.*\\S)?$"
          },
          "role": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "additionalProperties": true,
        "required": [
          "name"
        ]
      },
      "description": "配布データを編集・加工した主体。元データの作者は sources に記載する。name は重複しない。"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "attribution": {
            "type": "string"
          },
          "changes": {
            "type": "string"
          },
          "latestTimestamp": {
            "type": "string",
            "format": "date-time",
            "description": "この出典に由来する収録データの最終更新日時。不明なら省略する。"
          },
          "name": {
            "type": "string",
            "pattern": "^\\S(?:.*\\S)?$"
          }
        },
        "additionalProperties": true,
        "required": [
          "name"
        ]
      },
      "description": "識別子が重複しない情報の配列。"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^\\S(?:.*\\S)?$"
          },
          "nameReading": {
            "$ref": "#/$defs/nameReading"
          }
        },
        "additionalProperties": true,
        "required": [
          "name"
        ]
      },
      "description": "識別子が重複しない情報の配列。"
    },
    "nameReading": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          }
        }
      ]
    },
    "coverage": {
      "type": "object",
      "properties": {
        "regions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          }
        },
        "geometry": {
          "$ref": "#/$defs/coverageGeometry"
        },
        "finest": {
          "type": "object",
          "required": [
            "geometry"
          ],
          "properties": {
            "geometry": {
              "$ref": "#/$defs/coverageGeometry"
            }
          },
          "additionalProperties": true
        }
      },
      "dependentRequired": {
        "finest": [
          "geometry"
        ]
      },
      "additionalProperties": true
    },
    "coveragePosition": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "coverageRing": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/coveragePosition"
      }
    },
    "coveragePolygon": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/coverageRing"
      }
    },
    "coverageGeometry": {
      "type": "object",
      "required": [
        "type",
        "coordinates"
      ],
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "Polygon"
            },
            "coordinates": {
              "$ref": "#/$defs/coveragePolygon"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "MultiPolygon"
            },
            "coordinates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/coveragePolygon"
              }
            }
          }
        }
      ],
      "additionalProperties": true
    }
  }
}
