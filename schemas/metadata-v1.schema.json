{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "共通メタデータ（版1）",
  "description": "データ JSON と配布 manifest で共有する metadata。各項目は任意。データ種別ごとの必須条件は参照元で追加する。",
  "type": "object",
  "properties": {
    "sources": {
      "$ref": "#/$defs/sources"
    },
    "tags": {
      "$ref": "#/$defs/tags"
    },
    "pointCount": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": true,
  "$defs": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "attribution": {
            "type": "string"
          },
          "changes": {
            "type": "string"
          },
          "latestTimestamp": {
            "type": "string",
            "format": "date-time",
            "description": "この出典に由来する収録データの最終更新日時。不明なら省略する。"
          },
          "name": {
            "type": "string",
            "pattern": "^\\S(?:.*\\S)?$"
          }
        },
        "additionalProperties": true,
        "required": [
          "name"
        ]
      },
      "description": "識別子が重複しない情報の配列。"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^\\S(?:.*\\S)?$"
          },
          "nameReading": {
            "$ref": "#/$defs/nameReading"
          }
        },
        "additionalProperties": true,
        "required": [
          "name"
        ]
      },
      "description": "識別子が重複しない情報の配列。"
    },
    "nameReading": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          }
        }
      ]
    }
  }
}
