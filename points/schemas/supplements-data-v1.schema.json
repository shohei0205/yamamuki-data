{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "単一の地点補足 JSON（版1）",
  "type": "object",
  "required": [
    "schemaVersion",
    "points"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "metadata": {
      "$ref": "../../schemas/metadata-v1.schema.json",
      "not": {
        "required": [
          "pointCount"
        ]
      }
    },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "osmId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "note": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "pattern": "^\\S(?:.*\\S)?$"
          },
          "nameReading": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\S(?:.*\\S)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "tags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^\\S(?:.*\\S)?$"
            }
          },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\S(?:.*\\S)?$"
                },
                {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^\\S(?:.*\\S)?$"
                    },
                    "nameReading": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "pattern": "^\\S(?:.*\\S)?$"
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "aliasesRemove": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^\\S(?:.*\\S)?$"
            }
          },
          "exclude": {
            "type": "boolean"
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "nameReading": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "aliases": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^\\S(?:.*\\S)?$"
                    },
                    {
                      "type": "object",
                      "required": [
                        "name"
                      ],
                      "properties": {
                        "name": {
                          "type": "string",
                          "pattern": "^\\S(?:.*\\S)?$"
                        },
                        "nameReading": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "pattern": "^\\S(?:.*\\S)?$"
                        }
                      },
                      "additionalProperties": false
                    }
                  ]
                }
              }
            }
          },
          "tagsRemove": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^\\S(?:.*\\S)?$"
            }
          },
          "graphic": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "svg"
            ],
            "additionalProperties": false,
            "properties": {
              "svg": {
                "type": "string",
                "minLength": 1
              },
              "scale": {
                "type": [
                  "number",
                  "null"
                ],
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "anyOf": [
          {
            "required": [
              "name"
            ]
          },
          {
            "required": [
              "nameReading"
            ]
          },
          {
            "required": [
              "tags"
            ]
          },
          {
            "required": [
              "aliases"
            ]
          },
          {
            "required": [
              "aliasesRemove"
            ]
          },
          {
            "required": [
              "exclude"
            ]
          },
          {
            "required": [
              "tagsRemove"
            ]
          },
          {
            "required": [
              "graphic"
            ]
          }
        ],
        "oneOf": [
          {
            "required": [
              "id"
            ]
          },
          {
            "required": [
              "osmId"
            ]
          }
        ]
      }
    },
    "sources": {
      "$ref": "../../schemas/metadata-v1.schema.json#/$defs/sources"
    },
    "tags": {
      "$ref": "../../schemas/metadata-v1.schema.json#/$defs/tags"
    }
  },
  "$comment": "osmId の重複、別名の追加・削除の競合、expected と元データの一致は生成処理で検査する。",
  "not": {
    "allOf": [
      {
        "required": [
          "metadata"
        ]
      },
      {
        "anyOf": [
          {
            "required": [
              "sources"
            ]
          },
          {
            "required": [
              "tags"
            ]
          }
        ]
      }
    ]
  }
}
