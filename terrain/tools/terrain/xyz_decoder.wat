 (if (result i32) (i32.and (i32.eq (local.get $i) (local.get $count)) (i32.eq (global.get $cursor) (global.get $end))) (then (i32.const 0)) (else (i32.const -5))))
(func (export "vertices_new") (param $src i32) (param $count i32) (param $x i32) (param $y i32) (param $k i32) (param $out i32)
 (local $i i32) (local $p i32) (local $q i32)
 (loop $loop (if (i32.lt_u (local.get $i) (local.get $count)) (then
  (local.set $p (i32.add (local.get $src) (i32.mul (local.get $i) (i32.const 6))))
  (local.set $q (i32.add (local.get $out) (i32.mul (local.get $i) (i32.const 24))))
  (f64.store (local.get $q) (f64.convert_i32_s (i32.mul (i32.add (i32.mul (local.get $x) (i32.const 16384)) (i32.load16_s (local.get $p))) (local.get $k))))
  (f64.store offset=8 (local.get $q) (f64.convert_i32_s (i32.mul (i32.add (i32.mul (local.get $y) (i32.const 16384)) (i32.load16_s offset=2 (local.get $p))) (local.get $k))))
  (f64.store offset=16 (local.get $q) (f64.convert_i32_u (i32.load16_u offset=4 (local.get $p))))
  (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $loop)))))
(func (export "vertices_refs") (param $refs i32) (param $count i32) (param $table i32) (param $sizes i32) (param $out i32) (result i32)
 (local $i i32) (local $value i32) (local $slot i32) (local $index i32) (local $p i32)
 (loop $loop (if (i32.lt_u (local.get $i) (local.get $count)) (then
  (local.set $value (i32.load (i32.add (local.get $refs) (i32.mul (local.get $i) (i32.const 4)))))
  (local.set $slot (i32.shr_u (local.get $value) (i32.const 24))) (local.set $index (i32.and (local.get $value) (i32.const 16777215)))
  (if (i32.ge_u (local.get $index) (i32.load (i32.add (local.get $sizes) (i32.mul (local.get $slot) (i32.const 4))))) (then (return (i32.const -1))))
  (local.set $p (i32.add (i32.load (i32.add (local.get $table) (i32.mul (local.get $slot) (i32.const 4)))) (i32.mul (local.get $index) (i32.const 24))))
  (memory.copy (i32.add (local.get $out) (i32.mul (local.get $i) (i32.const 24))) (local.get $p) (i32.const 24))
