    (local.set $a (i64.load (i32.shl (local.get $edge) (i32.const 3))))
    (local.set $b (i64.load offset=128 (i32.shl (local.get $edge) (i32.const 3))))
    (if (i32.lt_u (local.get $tag) (i32.const 12))
     (then
      (if (i32.ge_u (local.get $tag) (local.get $nv)) (then (return (i32.const -5))))
      (local.set $c (i64.load offset=256 (i32.shl (local.get $tag) (i32.const 3)))))
     (else
      (if (i32.eq (local.get $tag) (i32.const 12)) (then (local.set $c (i64.add (local.get $a) (i64.const 1))))
       (else (if (i32.eq (local.get $tag) (i32.const 13)) (then (local.set $c (i64.add (local.get $b) (i64.const 1))))
        (else (if (i32.eq (local.get $tag) (i32.const 14)) (then (local.set $c (i64.add (local.get $last) (i64.const 1))))
         (else
          (local.set $p (call $read)) (if (i64.lt_s (local.get $p) (i64.const 0)) (then (return (i32.const -3))))
          (local.set $c (i64.add (select (local.get $b) (local.get $last) (i32.wrap_i64 (i64.and (local.get $p) (i64.const 1)))) (call $signed (i64.shr_u (local.get $p) (i64.const 1)))))))))))))
   ))
  (if (i32.or (i32.or (i64.ge_u (local.get $a) (local.get $vertexCount)) (i64.ge_u (local.get $b) (local.get $vertexCount))) (i64.ge_u (local.get $c) (local.get $vertexCount))) (then (return (i32.const -6))))
  (if (i32.or (i32.or (i64.eq (local.get $a) (local.get $b)) (i64.eq (local.get $b) (local.get $c))) (i64.eq (local.get $a) (local.get $c))) (then (return (i32.const -6))))
  (i32.store (i32.add (local.get $out) (i32.mul (local.get $i) (i32.const 12))) (i32.wrap_i64 (local.get $a)))
  (i32.store offset=4 (i32.add (local.get $out) (i32.mul (local.get $i) (i32.const 12))) (i32.wrap_i64 (local.get $b)))
  (i32.store offset=8 (i32.add (local.get $out) (i32.mul (local.get $i) (i32.const 12))) (i32.wrap_i64 (local.get $c)))
  (memory.copy (i32.const 24) (i32.const 0) (i32.const 96))
  (memory.copy (i32.const 152) (i32.const 128) (i32.const 96))
  (i64.store (i32.const 0) (local.get $b)) (i64.store (i32.const 128) (local.get $a))
  (i64.store (i32.const 8) (local.get $c)) (i64.store (i32.const 136) (local.get $b))
  (i64.store (i32.const 16) (local.get $a)) (i64.store (i32.const 144) (local.get $c))
  (local.set $edges (select (i32.add (local.get $edges) (i32.const 3)) (i32.const 15) (i32.lt_u (local.get $edges) (i32.const 12))))
  (local.set $j (i32.const 0))
  (loop $vertices
   (local.set $v (select (local.get $a) (select (local.get $b) (local.get $c) (i32.eq (local.get $j) (i32.const 1))) (i32.eqz (local.get $j))))
   (local.set $at (i32.const 0))
   (block $found (loop $search
    (br_if $found (i32.ge_u (local.get $at) (local.get $nv)))
    (br_if $found (i64.eq (i64.load offset=256 (i32.shl (local.get $at) (i32.const 3))) (local.get $v)))
    (local.set $at (i32.add (local.get $at) (i32.const 1))) (br $search)))
   (if (i32.and (i32.eq (local.get $at) (local.get $nv)) (i32.lt_u (local.get $nv) (i32.const 12))) (then (local.set $nv (i32.add (local.get $nv) (i32.const 1)))))
   (local.set $k (select (local.get $at) (i32.const 11) (i32.lt_u (local.get $at) (i32.const 12))))
   (block $moved (loop $move
    (br_if $moved (i32.eqz (local.get $k)))
    (i64.store offset=256 (i32.shl (local.get $k) (i32.const 3)) (i64.load offset=248 (i32.shl (local.get $k) (i32.const 3))))
    (local.set $k (i32.sub (local.get $k) (i32.const 1))) (br $move)))
   (i64.store (i32.const 256) (local.get $v))
   (local.set $j (i32.add (local.get $j) (i32.const 1))) (br_if $vertices (i32.lt_u (local.get $j) (i32.const 3))))
  (local.set $last (local.get $c))
  (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $faces)))
 (if (result i32) (i32.eq (global.get $cursor) (global.get $end)) (then (i32.const 0)) (else (i32.const -7))))
;; packed親参照の展開。可変長数の演算はi64、保存はu32。
(func (export "refs_decode") (param $src i32) (param $len i32) (param $mode i32) (param $count i32) (param $deps i32) (param $out i32) (result i32)
 (local $groups i32) (local $g i32) (local $slot i32) (local $previous i32) (local $number i64) (local $index i64) (local $delta i64) (local $i i32) (local $j i32) (local $value i32)
 (if (i32.eqz (local.get $mode)) (then
  (if (i32.ne (local.get $len) (i32.mul (local.get $count) (i32.const 4))) (then (return (i32.const -1))))
  (loop $raw
   (if (i32.lt_u (local.get $i) (local.get $count)) (then
    (local.set $value (i32.load (i32.add (local.get $src) (i32.mul (local.get $i) (i32.const 4)))))
    (if (i32.ge_u (i32.shr_u (local.get $value) (i32.const 24)) (local.get $deps)) (then (return (i32.const -2))))
    (i32.store (i32.add (local.get $out) (i32.mul (local.get $i) (i32.const 4))) (local.get $value))
    (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $raw))))
  (return (i32.const 0))))
 (if (i32.or (i32.ne (local.get $mode) (i32.const 1)) (i32.lt_u (local.get $len) (i32.const 2))) (then (return (i32.const -1))))
 (local.set $groups (i32.load16_u (local.get $src))) (local.set $previous (i32.const -1))
 (if (i32.or (i32.eqz (local.get $groups)) (i32.gt_u (local.get $groups) (local.get $deps))) (then (return (i32.const -2))))
 (global.set $cursor (i32.add (local.get $src) (i32.const 2))) (global.set $end (i32.add (local.get $src) (local.get $len)))
 (loop $group
  (if (i32.ge_u (global.get $cursor) (global.get $end)) (then (return (i32.const -3))))
  (local.set $slot (i32.load8_u (global.get $cursor))) (global.set $cursor (i32.add (global.get $cursor) (i32.const 1)))
  (if (i32.or (i32.le_s (local.get $slot) (local.get $previous)) (i32.ge_u (local.get $slot) (local.get $deps))) (then (return (i32.const -2)))) (local.set $previous (local.get $slot))
  (local.set $number (call $read)) (local.set $index (call $read))
  (if (i32.or (i64.le_s (local.get $number) (i64.const 0)) (i64.gt_u (local.get $number) (i64.extend_i32_u (i32.sub (local.get $count) (local.get $i))))) (then (return (i32.const -3))))
  (local.set $j (i32.const 0))
  (loop $indices
   (if (i32.gt_u (local.get $j) (i32.const 0)) (then
    (local.set $delta (call $read)) (if (i64.lt_s (local.get $delta) (i64.const 0)) (then (return (i32.const -3))))
    (local.set $index (i64.add (local.get $index) (i64.add (local.get $delta) (i64.const 1))))))
