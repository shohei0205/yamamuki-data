   (local.set $i (i32.add (local.get $i) (i32.const 1))) (local.set $j (i32.add (local.get $j) (i32.const 1)))
   (br_if $indices (i64.lt_u (i64.extend_i32_u (local.get $j)) (local.get $number))))
