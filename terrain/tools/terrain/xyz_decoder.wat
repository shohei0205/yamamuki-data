;; YMV4/TFC2 独立復元器。状態領域は0..351、入出力は65536以降。
(module
(memory (export "memory") 2 8192)
(global (export "__heap_base") i32 (i32.const 65536))
(global $cursor (mut i32) (i32.const 0))
(global $end (mut i32) (i32.const 0))
(func $read (result i64) (local $value i64) (local $shift i64) (local $byte i32)
 (loop $again
  (if (i32.ge_u (global.get $cursor) (global.get $end)) (then (return (i64.const -1))))
  (local.set $byte (i32.load8_u (global.get $cursor)))
  (global.set $cursor (i32.add (global.get $cursor) (i32.const 1)))
  (local.set $value (i64.or (local.get $value) (i64.shl (i64.extend_i32_u (i32.and (local.get $byte) (i32.const 127))) (local.get $shift))))
  (if (i32.lt_u (local.get $byte) (i32.const 128)) (then (return (local.get $value))))
  (local.set $shift (i64.add (local.get $shift) (i64.const 7)))
  (br_if $again (i64.lt_u (local.get $shift) (i64.const 35))))
 (i64.const -1))
(func $signed (param $v i64) (result i64)
 (i64.xor (i64.shr_u (local.get $v) (i64.const 1)) (i64.sub (i64.const 0) (i64.and (local.get $v) (i64.const 1)))))
(func (export "tfc_decode") (param $src i32) (param $len i32) (param $out i32) (param $count i32) (param $vertexCount i64) (result i32)
 (local $i i32) (local $a i64) (local $b i64) (local $c i64) (local $p i64)
 (local $code i32) (local $edge i32) (local $tag i32) (local $edges i32) (local $nv i32)
 (local $last i64) (local $j i32) (local $at i32) (local $k i32) (local $v i64)
 (if (i32.or (i32.eqz (local.get $len)) (i32.ne (i32.load8_u (local.get $src)) (i32.const 194))) (then (return (i32.const -1))))
 (global.set $cursor (i32.add (local.get $src) (i32.const 1)))
 (global.set $end (i32.add (local.get $src) (local.get $len)))
 (block $done (loop $faces
  (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
  (if (i32.ge_u (global.get $cursor) (global.get $end)) (then (return (i32.const -2))))
  (local.set $code (i32.load8_u (global.get $cursor)))
  (global.set $cursor (i32.add (global.get $cursor) (i32.const 1)))
  (if (i32.eq (local.get $code) (i32.const 240))
   (then
    (local.set $p (call $read)) (if (i64.lt_s (local.get $p) (i64.const 0)) (then (return (i32.const -3))))
    (local.set $a (i64.add (local.get $last) (call $signed (local.get $p))))
    (local.set $p (call $read)) (if (i64.lt_s (local.get $p) (i64.const 0)) (then (return (i32.const -3))))
    (local.set $b (i64.add (local.get $a) (call $signed (local.get $p))))
    (local.set $p (call $read)) (if (i64.lt_s (local.get $p) (i64.const 0)) (then (return (i32.const -3))))
    (local.set $c (i64.add (local.get $b) (call $signed (local.get $p)))))
   (else
    (if (i32.ge_u (local.get $code) (i32.const 240)) (then (return (i32.const -4))))
    (local.set $edge (i32.shr_u (local.get $code) (i32.const 4)))
    (local.set $tag (i32.and (local.get $code) (i32.const 15)))
