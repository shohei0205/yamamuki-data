;; TFC1の独立WASM復元器。0..87はFIFO/LRU、65536以降は入出力用。
(module
 (memory (export "memory") 2 1024)
 (global (export "__heap_base") i32 (i32.const 65536))
 (global $cursor (mut i32) (i32.const 0))
 (global $end (mut i32) (i32.const 0))
 (func $read (result i32) (local $a i32) (local $b i32) (local $c i32)
  (if (i32.ge_u (global.get $cursor) (global.get $end)) (then (return (i32.const -1))))
  (local.set $a (i32.load8_u (global.get $cursor)))
  (global.set $cursor (i32.add (global.get $cursor) (i32.const 1)))
  (if (i32.lt_u (local.get $a) (i32.const 128)) (then (return (local.get $a))))
  (if (i32.ge_u (global.get $cursor) (global.get $end)) (then (return (i32.const -1))))
  (local.set $b (i32.load8_u (global.get $cursor)))
  (global.set $cursor (i32.add (global.get $cursor) (i32.const 1)))
  (if (i32.lt_u (local.get $b) (i32.const 128))
   (then (return (i32.or (i32.and (local.get $a) (i32.const 127)) (i32.shl (local.get $b) (i32.const 7))))))
  (if (i32.ge_u (global.get $cursor) (global.get $end)) (then (return (i32.const -1))))
  (local.set $c (i32.load8_u (global.get $cursor)))
  (global.set $cursor (i32.add (global.get $cursor) (i32.const 1)))
  (if (i32.ge_u (local.get $c) (i32.const 128)) (then (return (i32.const -1))))
  (i32.or (i32.or (i32.and (local.get $a) (i32.const 127)) (i32.shl (i32.and (local.get $b) (i32.const 127)) (i32.const 7))) (i32.shl (local.get $c) (i32.const 14)))
 )
 (func $signed (param $v i32) (result i32)
  (i32.xor (i32.shr_u (local.get $v) (i32.const 1)) (i32.sub (i32.const 0) (i32.and (local.get $v) (i32.const 1)))))
 (func (export "tfc_decode") (param $src i32) (param $len i32) (param $out i32) (param $count i32) (param $vertexCount i32) (result i32)
  (local $i i32) (local $a i32) (local $b i32) (local $c i32) (local $p i32)
  (local $code i32) (local $edge i32) (local $tag i32) (local $edges i32) (local $nv i32)
  (local $last i32) (local $j i32) (local $at i32) (local $k i32) (local $v i32)
  (if (i32.or (i32.gt_u (local.get $count) (i32.const 6000000)) (i32.rem_u (local.get $count) (i32.const 3))) (then (return (i32.const -1))))
  (if (i32.or (i32.eqz (local.get $vertexCount)) (i32.gt_u (local.get $vertexCount) (i32.const 65536))) (then (return (i32.const -1))))
  (if (i32.eqz (local.get $len)) (then (return (i32.const -2))))
  (if (i32.ne (i32.load8_u (local.get $src)) (i32.const 193)) (then (return (i32.const -2))))
  (global.set $cursor (i32.add (local.get $src) (i32.const 1)))
  (global.set $end (i32.add (local.get $src) (local.get $len)))
  (block $done (loop $faces
   (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
   (if (i32.ge_u (global.get $cursor) (global.get $end)) (then (return (i32.const -3))))
   (local.set $code (i32.load8_u (global.get $cursor)))
   (global.set $cursor (i32.add (global.get $cursor) (i32.const 1)))
   (if (i32.eq (local.get $code) (i32.const 240))
    (then
     (local.set $p (call $read)) (if (i32.lt_s (local.get $p) (i32.const 0)) (then (return (i32.const -3))))
     (local.set $a (i32.add (local.get $last) (call $signed (local.get $p))))
     (local.set $p (call $read)) (if (i32.lt_s (local.get $p) (i32.const 0)) (then (return (i32.const -3))))
     (local.set $b (i32.add (local.get $a) (call $signed (local.get $p))))
     (local.set $p (call $read)) (if (i32.lt_s (local.get $p) (i32.const 0)) (then (return (i32.const -3))))
     (local.set $c (i32.add (local.get $b) (call $signed (local.get $p))))
    )
    (else
     (if (i32.gt_u (local.get $code) (i32.const 240)) (then (return (i32.const -4))))
     (local.set $edge (i32.shr_u (local.get $code) (i32.const 4)))
     (local.set $tag (i32.and (local.get $code) (i32.const 15)))
     (if (i32.ge_u (local.get $edge) (local.get $edges)) (then (return (i32.const -5))))
     (local.set $a (i32.load16_u (i32.shl (local.get $edge) (i32.const 1))))
     (local.set $b (i32.load16_u offset=32 (i32.shl (local.get $edge) (i32.const 1))))
     (if (i32.lt_u (local.get $tag) (i32.const 12))
      (then
       (if (i32.ge_u (local.get $tag) (local.get $nv)) (then (return (i32.const -5))))
       (local.set $c (i32.load16_u offset=64 (i32.shl (local.get $tag) (i32.const 1))))
      )
      (else
       (if (i32.eq (local.get $tag) (i32.const 12)) (then (local.set $c (i32.add (local.get $a) (i32.const 1))))
        (else (if (i32.eq (local.get $tag) (i32.const 13)) (then (local.set $c (i32.add (local.get $b) (i32.const 1))))
         (else (if (i32.eq (local.get $tag) (i32.const 14)) (then (local.set $c (i32.add (local.get $last) (i32.const 1))))
          (else
           (local.set $p (call $read)) (if (i32.lt_s (local.get $p) (i32.const 0)) (then (return (i32.const -3))))
           (local.set $c (i32.add (select (local.get $b) (local.get $last) (i32.and (local.get $p) (i32.const 1))) (call $signed (i32.shr_u (local.get $p) (i32.const 1)))))
          ))
         ))
        ))
      ))
    ))
   (if (i32.or (i32.or (i32.ge_u (local.get $a) (local.get $vertexCount)) (i32.ge_u (local.get $b) (local.get $vertexCount))) (i32.ge_u (local.get $c) (local.get $vertexCount))) (then (return (i32.const -6))))
   (i32.store16 (i32.add (local.get $out) (i32.shl (local.get $i) (i32.const 1))) (local.get $a))
   (i32.store16 offset=2 (i32.add (local.get $out) (i32.shl (local.get $i) (i32.const 1))) (local.get $b))
   (i32.store16 offset=4 (i32.add (local.get $out) (i32.shl (local.get $i) (i32.const 1))) (local.get $c))
   ;; 重なりのある24バイト移動を後ろから3回で行う。
   (i64.store offset=22 align=2 (i32.const 0) (i64.load offset=16 (i32.const 0)))
   (i64.store offset=14 align=2 (i32.const 0) (i64.load offset=8 (i32.const 0)))
   (i64.store offset=6 align=2 (i32.const 0) (i64.load (i32.const 0)))
   (i64.store offset=22 align=2 (i32.const 32) (i64.load offset=16 (i32.const 32)))
   (i64.store offset=14 align=2 (i32.const 32) (i64.load offset=8 (i32.const 32)))
   (i64.store offset=6 align=2 (i32.const 32) (i64.load (i32.const 32)))
   (i32.store16 (i32.const 0) (local.get $b)) (i32.store16 (i32.const 32) (local.get $a))
   (i32.store16 (i32.const 2) (local.get $c)) (i32.store16 (i32.const 34) (local.get $b))
   (i32.store16 (i32.const 4) (local.get $a)) (i32.store16 (i32.const 36) (local.get $c))
   (local.set $edges (select (i32.add (local.get $edges) (i32.const 3)) (i32.const 15) (i32.lt_u (local.get $edges) (i32.const 12))))
   (local.set $j (i32.const 0))
   (loop $vertices
    (local.set $v (select (local.get $a) (select (local.get $b) (local.get $c) (i32.eq (local.get $j) (i32.const 1))) (i32.eqz (local.get $j))))
    (local.set $at (i32.const 0))
    (block $found (loop $search
     (br_if $found (i32.ge_u (local.get $at) (local.get $nv)))
     (br_if $found (i32.eq (i32.load16_u offset=64 (i32.shl (local.get $at) (i32.const 1))) (local.get $v)))
     (local.set $at (i32.add (local.get $at) (i32.const 1))) (br $search)
    ))
    (if (i32.and (i32.eq (local.get $at) (local.get $nv)) (i32.lt_u (local.get $nv) (i32.const 12))) (then (local.set $nv (i32.add (local.get $nv) (i32.const 1)))))
    (local.set $k (select (local.get $at) (i32.const 11) (i32.lt_u (local.get $at) (i32.const 12))))
    (block $moved (loop $move
     (br_if $moved (i32.eqz (local.get $k)))
     (i32.store16 offset=64 (i32.shl (local.get $k) (i32.const 1)) (i32.load16_u offset=62 (i32.shl (local.get $k) (i32.const 1))))
     (local.set $k (i32.sub (local.get $k) (i32.const 1))) (br $move)
    ))
    (i32.store16 (i32.const 64) (local.get $v))
    (local.set $j (i32.add (local.get $j) (i32.const 1)))
    (br_if $vertices (i32.lt_u (local.get $j) (i32.const 3)))
   )
   (local.set $last (local.get $c))
   (local.set $i (i32.add (local.get $i) (i32.const 3))) (br $faces)
  ))
  (if (result i32) (i32.eq (global.get $cursor) (global.get $end)) (then (i32.const 0)) (else (i32.const -7)))
 )
)
